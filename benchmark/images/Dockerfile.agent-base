# Build this image once. Every P15 task image reuses it, so Harbor does not
# download the same Agent CLI again for each trial.
FROM python:3.11.16-slim-bookworm@sha256:528257d48c1da0dcecc2e725d1ae34498d60c965f1241e39cd6a85a8859bdf84

LABEL org.opencontainers.image.title="P15 Harbor Agent Base" \
      org.opencontainers.image.version="p15-harbor-0.22.0-agentset-1" \
      p15.harbor.version="0.22.0" \
      p15.codex.version="0.151.0" \
      p15.claude-code.version="2.1.251" \
      p15.qwen-code.version="0.22.3" \
      p15.openpyxl.version="3.1.5"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash ca-certificates curl git procps ripgrep unzip \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs=22.23.2-1nodesource1 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir openpyxl==3.1.5 \
    && npm install -g \
       @openai/codex@0.151.0 \
       @anthropic-ai/claude-code@2.1.251 \
       @qwen-code/qwen-code@0.22.3 \
    && codex --version \
    && claude --version \
    && qwen --version \
    && npm cache clean --force

# Harbor 0.22.0's stock Qwen adapter sources this file even when Node is
# installed system-wide. The public runner also supplies a narrow compatibility
# shim so a matching preinstalled Qwen version is reused instead of reinstalled.
RUN mkdir -p /root/.nvm /root/.qwen \
    && printf '%s\n' 'export PATH="/usr/local/bin:$PATH"' > /root/.nvm/nvm.sh
COPY qwen-settings.json /root/.qwen/settings.json

WORKDIR /app
